# cloud-relay configuration. Copy to .env to use; never commit .env.
#
# Two flavors of environment variable are honored:
#   - CLOUD_RELAY_*  -- cloud-relay's own settings (see core/config.py and
#                       services/<cloud>/_core/config.py).
#   - AWS_*          -- standard AWS variables read by boto3 directly
#                       (AWS_REGION, AWS_PROFILE, AWS_ACCESS_KEY_ID, etc.).
#                       cloud-relay does not duplicate these; they Just Work.

# ---------- cloud-neutral ----------
# Root log level for the library/CLI/API (DEBUG, INFO, WARNING, ERROR).
CLOUD_RELAY_LOG_LEVEL=INFO

# ---------- AWS-specific ----------
# AWS region override. Leave unset to defer to AWS_REGION / shared config.
# Set to a us-gov-* region for GovCloud (boto3 picks the right endpoints).
# CLOUD_RELAY_REGION=us-east-1

# Named AWS profile from ~/.aws/credentials.
# CLOUD_RELAY_PROFILE=default

# Endpoint override for tests / localstack / vpce. Leave unset in production.
# CLOUD_RELAY_ENDPOINT_URL=http://localhost:4566

# botocore retry policy.
# CLOUD_RELAY_MAX_RETRIES=3
# CLOUD_RELAY_RETRY_MODE=standard
